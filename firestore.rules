rules_version = '2';

// TCGHaven Firestore rules.
//
// Who can write the shared data (catalog, registry, sync status, price history):
//   - The Owner — Alex's account, hardcoded below as the root of trust so the Owner can never be
//     locked out. Also the only one who can add/remove staff.
//   - Staff — anyone with a staff/{uid} record, added by the Owner from the staff portal (/admin,
//     lib/firebase/staff.ts). Removing the record removes their access everywhere at once.
//   - The dedicated email/password "sync" account the scripts and server-side syncs sign in as.
// None of these uids are secrets. Deploy via `firebase deploy --only firestore:rules` (needs
// `firebase login` once) or by pasting this file's contents into the Console's Rules tab.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isOwner() {
      return signedIn() && (
        request.auth.uid == 'kOVse5dvMDOSkxlitTAh1Q99sJD3' ||
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'owner')
      );
    }

    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // A banned account (Accounts page, lib/accountRoles.ts) can't save anything. Deleting their
    // own data stays allowed, so they can still delete their account.
    function notBanned() {
      return !exists(/databases/$(database)/documents/account_roles/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/account_roles/$(request.auth.uid)).data.get('banned', false) != true;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.uid in ['kOVse5dvMDOSkxlitTAh1Q99sJD3', 'yahGroB7ebaSebrsnAIRhooKVdk1'] ||
        isStaff()
      );
    }

    // Staff list. Staff can see the team; only the Owner adds or removes people (and can't
    // remove themselves). A staff member may update only their own "must change password" flag,
    // after choosing their own password on first sign-in.
    match /staff/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isOwner() && request.resource.data.role in ['owner', 'staff'];
      allow update: if isOwner() || (
        signedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
      );
      allow delete: if isOwner() && request.auth.uid != uid;
    }

    // Who may make creator things (lib/accountRoles.ts canUseCreatorStudio): a Creator in good
    // standing, or staff (to try it and help creators). Never a banned account.
    function canCreate() {
      return signedIn() && notBanned() && (isAdmin() || (
        exists(/databases/$(database)/documents/account_roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/account_roles/$(request.auth.uid)).data.role == 'creator' &&
        get(/databases/$(database)/documents/account_roles/$(request.auth.uid)).data.get('suspended', false) != true
      ));
    }

    // Creator Books (lib/creatorBooks.ts, docs/creators.md): one per creator, at their uid. Every
    // collector can read them (the app shows a book only while its maker is a Creator); only the
    // creator writes their own. Deleting stays allowed for them and staff.
    match /creator_books/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && canCreate()
        && request.resource.data.owner == uid
        && request.resource.data.badges is list && request.resource.data.badges.size() <= 200;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // A creator's community profile (barebones for now): name, tagline, about, colour
    match /communities/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && canCreate()
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'tagline', 'about', 'color', 'updatedAt']);
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Joining a community (lib/communities.ts): {communityUid}_{memberUid}. Anyone signed in reads
    // (member counts, "your communities"); you add and remove only your own membership.
    match /community_members/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && notBanned()
        && request.resource.data.member == request.auth.uid
        && id == request.resource.data.community + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/communities/$(request.resource.data.community))
        && request.resource.data.keys().hasOnly(['community', 'member', 'joinedAt']);
      allow delete: if signedIn() && resource.data.member == request.auth.uid;
    }

    // Account titles (lib/accountRoles.ts): { role, creatorSince?, formerCreator?, updatedAt }; no
    // doc = Regular. Titles show on profiles, so any signed-in collector can read them; only staff
    // set them (nobody can make themselves Premium or a Creator). The history — who changed it and
    // why, possibly about a suspension — is staff only.
    match /account_roles/{uid} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.role in ['regular', 'premium', 'creator', 'staff']
        && request.resource.data.keys().hasOnly(['role', 'creatorSince', 'formerCreator', 'suspended', 'banned', 'updatedAt']);
      allow delete: if isAdmin();
      match /history/{id} {
        allow read, create: if isAdmin();
      }
    }

    // ── Usage statistics (lib/usage.ts, lib/stats/aggregate.ts) ──────────────────────────────
    // The sync bot account that runs the server jobs, including the nightly Statistics totals.
    function isBot() { return signedIn() && request.auth.uid == 'yahGroB7ebaSebrsnAIRhooKVdk1'; }

    // One doc per account per day, written by that account's own app (increments only). NOBODY
    // reads them but the totals job — not staff, not the Owner: staff see daily totals only.
    match /usage_days/{id} {
      allow create, update: if signedIn() && notBanned()
        && id == request.resource.data.day + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day is string && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['uid', 'day', 'seconds', 'sessions', 'app', 'web', 'pages', 'visits', 'updatedAt']);
      allow read, delete: if isBot();
      // Deleting your account removes your own days (by id — you still can't read them)
      allow delete: if signedIn() && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_' + request.auth.uid + '$');
    }

    // Each account's counts-only summary (cards per game, graded counts, friends, badges, first and
    // last day used) — worked out on the device; never card names, prices or what was paid. Written
    // by its own account; read only by the totals job.
    match /user_stats/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid && notBanned()
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'cards', 'sold', 'friends', 'badgesEarned', 'firstDay', 'lastDay', 'platform', 'updatedAt']);
      allow delete: if signedIn() && request.auth.uid == uid;
      allow read: if isBot();
    }

    // The daily totals the staff portal's Statistics page reads. Written by the totals job.
    match /stats_daily/{day} {
      allow read: if isAdmin();
      allow write: if isBot();
    }

    // Haven Premium's prices (lib/premium.ts) — everyone can read them (the app shows them on the
    // upgrade screen); only the Owner changes them.
    match /premium/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Promo codes for free months of Premium — the Owner only. Redeeming one will be checked and
    // counted on the server, never by the app writing here.
    match /promo_codes/{code} {
      allow read, write: if isOwner();
    }

    // Finances — the Owner only (the staff portal's Finances page: costs, and later revenue).
    match /finance/{doc} {
      allow read, write: if isOwner();
    }

    // Who's in the staff portal right now (lib/firebase/staff.ts): { lastSeen, page }, written by
    // each staff member's own portal while it's open. Staff can see the team's; the Owner clears
    // a removed member's.
    match /staff_presence/{uid} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastSeen', 'page']);
      allow delete: if isOwner();
    }

    // Card catalog — the shared source of truth. Content isn't sensitive (names, images,
    // prices), so reads are open to anyone; only the admin account can write.
    match /catalog/{game}/cards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pre-sharded full-catalog snapshot chunks (~1500 cards each, under Firestore's 1MiB
    // per-document limit) — what a cold app instance reads on startup instead of scanning
    // every card document individually.
    match /catalog_snapshot/{game}/chunks/{chunkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sync bookkeeping (lastBulkSyncAt per game) used by the download script to avoid
    // clobbering a manual admin edit made since its last run.
    match /catalog_meta/{game} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Last sync attempt per game (ok/error/timestamp) — surfaced on the Admin Catalog Sync
    // panel so a cron-triggered failure is visible without digging through logs.
    match /sync_status/{game} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Set registry (Lorcana/Riftbound set metadata, Cardex/Pack Analysis wiring) — formerly
    // data/set-registry.json. Moved to Firestore so the Admin Catalog sync routes can write it
    // from a Vercel serverless function, which has no writable local filesystem.
    match /registry/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shared, catalog-level daily price history (scripts/lib/price-history.mjs) — one copy for
    // every user, written by the scheduled sync. Same access as the catalog itself.
    match /price_history/{game}/months/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Each day's whole-game prices and each card's first price (price-history.mjs "Daily closes").
    match /price_history/{game}/days/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /price_history/{game}/firsts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Friends (lib/firebase/friends.ts) ──────────────────────────────────────────────────
    // A collector's public card: name, @username, photo (never their email). Any signed-in
    // user can find people by name/username; only you can write yours, and the username on it
    // must be one you've claimed in /usernames.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && notBanned()
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'previousUsernames', 'displayName', 'displayNameLower', 'photoURL', 'bio', 'privacy', 'pinDisplay', 'createdAt', 'updatedAt'])
        && (!('previousUsernames' in request.resource.data) || (request.resource.data.previousUsernames is list && request.resource.data.previousUsernames.size() <= 3))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
        && (!('privacy' in request.resource.data) || request.resource.data.privacy.keys().hasOnly(['cardex', 'badges']))
        && (!('pinDisplay' in request.resource.data) || (request.resource.data.pinDisplay is list && request.resource.data.pinDisplay.size() <= 6))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      // Only by its owner, deleting their account (lib/firebase/deleteAccount.ts)
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Username claims — the doc id is the username, so two people can't hold the same one. A
    // rename keeps your last 3 old names (still yours, old links still find you); the app deletes
    // older ones, which frees them for anyone.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && notBanned()
        && request.resource.data.keys().hasOnly(['uid'])
        && name.matches('^[a-z0-9_.]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Accepted friends only — the pair's doc id is the two uids sorted, so check both orders.
    function isFriendOf(other) {
      return signedIn() && (
        (exists(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + other)) &&
         get(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + other)).data.status == 'accepted') ||
        (exists(/databases/$(database)/documents/friendships/$(other + '_' + request.auth.uid)) &&
         get(/databases/$(database)/documents/friendships/$(other + '_' + request.auth.uid)).data.status == 'accepted')
      );
    }

    // A copy of which cards someone owns (no prices or purchase info), kept only while they share
    // their Cardex. Any signed-in collector can read it while the profile's privacy.cardex is on (the default). The
    // Portfolio has no shared copy at all — it's never visible to anyone else.
    match /shared_cardex/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/profiles/$(uid)).data.get('privacy', {}).get('cardex', false) == true
      );
      allow create, update: if signedIn() && request.auth.uid == uid && notBanned();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // The badge catalog — every pin book and badge (lib/badgeCatalog.ts), edited in the staff
    // portal's Badges page. Anyone can read it; only staff change it.
    match /badge_catalog/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Haven Badges (lib/badges.ts): { earned: { badgeId: earnedAtMillis }, progress: { badgeId:
    // [have, total] } }, kept up to date by the owner's own app. Readable by the owner, or by any
    // signed-in collector while the profile's privacy.badges is on (the default).
    match /shared_badges/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/profiles/$(uid)).data.get('privacy', {}).get('badges', false) == true
      );
      allow create, update: if signedIn() && request.auth.uid == uid && notBanned()
        && request.resource.data.keys().hasOnly(['earned', 'progress', 'updatedAt'])
        && request.resource.data.earned is map && request.resource.data.progress is map;
      // A delete has no new data to check, so it can't share the rule above (deleting an account)
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Old personal invite links — /invite/{code} now just opens that person's Haven. Looked up one
    // at a time, never listed; no longer created.
    match /invite_codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // One doc per pair of collectors, id = their two uids sorted and joined by "_". Only the
    // two of them can see it. A request always starts 'pending' and only the person it was sent to
    // can accept it — there's no way to become someone's friend without their say-so. Either of
    // them can delete it (decline, cancel, unfriend).
    match /friendships/{id} {
      allow read: if signedIn()
        && (resource.data.requester == request.auth.uid || resource.data.addressee == request.auth.uid);
      allow create: if signedIn() && notBanned()
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.addressee is string
        && request.resource.data.addressee != request.auth.uid
        && (id == request.auth.uid + '_' + request.resource.data.addressee
            || id == request.resource.data.addressee + '_' + request.auth.uid)
        && request.resource.data.users.size() == 2
        && request.resource.data.users.hasAll([request.auth.uid, request.resource.data.addressee])
        && request.resource.data.keys().hasOnly(['users', 'requester', 'addressee', 'status', 'createdAt', 'respondedAt', 'inviteCode'])
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.addressee))
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && notBanned()
        && resource.data.addressee == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if signedIn()
        && (resource.data.requester == request.auth.uid || resource.data.addressee == request.auth.uid);
    }

    // Per-user inventory data — unchanged from before this migration. A user may only
    // read/write their own subtree.
    match /users/{uid}/{document=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && notBanned();
    }
  }
}
