rules_version = '2';

// TCGHaven Firebase Storage rules — catalog card photos uploaded from the Admin Catalog page.
// Same people as firestore.rules' isAdmin(): the Owner, the download script's dedicated sync
// account, and anyone on the staff list (staff/{uid} in Firestore — read via firestore.exists(),
// which Firebase asks to grant permission for on the first deploy). Deploy via
// `firebase deploy --only storage`, or paste into the Console's Storage Rules tab.

service firebase.storage {
  match /b/{bucket}/o {
    match /catalog/{game}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid in ['kOVse5dvMDOSkxlitTAh1Q99sJD3', 'yahGroB7ebaSebrsnAIRhooKVdk1'] ||
        firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid))
      );
    }
  }
}
